# ---------------------------------------------------------------------------
# Stripe API keys — https://dashboard.stripe.com/test/apikeys
# TEST MODE ONLY. Never put live keys in this project.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret.
#   Local:  stripe listen --forward-connect-to localhost:3000/webhooks
#   Hosted: Dashboard > Developers > Webhooks > add endpoint (enable Connect events)
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public base URL of this server. Used for Connect onboarding refresh/return
# URLs and Checkout success/cancel URLs. Must be the PUBLIC url once deployed.
#   Local:  http://localhost:3000
#   Railway: https://<your-app>.up.railway.app
BASE_URL=http://localhost:3000

# SQLite file location. Local default is fine; on Railway point this at the
# mounted volume (e.g. /data/lab.db) so data survives redeploys.
DB_PATH=./lab.db

# ---------------------------------------------------------------------------
# Platform defaults (the "30%" config surface — overridable per merchant)
# ---------------------------------------------------------------------------
PLATFORM_FEE_BPS=250
DEFAULT_COUNTRY=SG
DEFAULT_CURRENCY=sgd
